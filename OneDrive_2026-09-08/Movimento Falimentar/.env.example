# Chave pública atual do CNJ DataJud.
# Obtenha em: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
DATAJUD_API_KEY=
# OPCIONAL: deixe vazio. O sistema tenta obter a chave vigente na Wiki oficial e
# possui uma chave pública de fallback para iniciar sem configuração manual.

# Porta do painel local
PORT=3333

# Horário diário do scan (fuso da máquina). Ex.: 07:00
SCAN_CRON=0 7 * * *

# Quantos dias para trás pesquisar em cada execução
LOOKBACK_DAYS=2

# Quantos resultados por tribunal em cada lote
BATCH_SIZE=100
